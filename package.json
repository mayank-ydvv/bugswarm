{
  "name": "bugswarm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test \"web/lib/**/*.test.ts\" \"worker/src/**/*.test.ts\"",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > web/lib/database.types.ts",
    "db:check": "for f in supabase/tests/*_checks.sql; do docker exec -i supabase_db_bugswarm psql -U postgres -q -f - < $f || exit 1; done",
    "sample:init": "sh scripts/sample-init.sh"
  },
  "devDependencies": {
    "supabase": "^2.120.0"
  }
}
