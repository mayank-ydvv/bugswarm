{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "housekeeping": "node --env-file-if-exists=../.env src/housekeeping.ts"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "lighthouse": "^12.8.2",
    "openai": "^6.49.0",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
