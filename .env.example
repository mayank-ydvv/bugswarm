# One env file for web + worker (web/next.config.ts and worker scripts load ../.env).
# Local values below come from `pnpm supabase status`; they are the CLI's public demo keys.

# --- Supabase ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-ANON_KEY-from-supabase-status
# Server and worker only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=paste-SERVICE_ROLE_KEY-from-supabase-status

# GitHub sign-in for the local Supabase stack (read by supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# --- AI (free tiers) ---
# Free key: https://aistudio.google.com/apikey. Model ids are never hardcoded; pick current ones from
# https://ai.google.dev/gemini-api/docs/models (e.g. a Flash-Lite model for GEMINI_LITE, Flash for GEMINI_FLASH).
GEMINI_KEY=
GEMINI_LITE=
GEMINI_FLASH=
# Optional fallback, used when Gemini fails (rate limited after retries, bad key, outage).
# Free key: https://openrouter.ai/keys. Comma-separated model ids ending in :free, tried in order
# (see https://openrouter.ai/models?max_price=0).
OPENROUTER_KEY=
OPENROUTER_MODELS=
# Per-run AI budgets: explainer batches (25 bugs each), uncached review calls, generated-test files.
# EXPLAIN_MAX_BATCHES=20
# REVIEW_MAX_CALLS=20
# TESTGEN_MAX_FILES=5

# --- GitHub push webhook ---
# Each project has its own secret: Project settings → Scan on every push shows the payload URL and
# secret to paste into the repo's webhook. Optional: an operator-wide secret that matches every project.
GH_WEBHOOK_SECRET=

# --- Worker ---
CONCURRENCY=2
# Docker Desktop (macOS/Windows) cannot reach container IPs; publish app ports on 127.0.0.1 instead.
DOCKER_PUBLISH_PORTS=true
# Local dev only: allow file:// repo URLs (used by `pnpm sample:init`). Keep false in production.
ALLOW_FILE_REPOS=true
# Checkouts live here (one dir per project). Must be shared with Docker Desktop (anything under $HOME is).
# WORK_ROOT=
# Semgrep ruleset. `auto` requires sending metrics to Semgrep, so a registry pack is the default.
SEMGREP_CONFIG=p/default
