# Web app environment (e.g. Vercel → Settings → Environment Variables).
# NEXT_PUBLIC_* values are shipped to browsers; they are public by design (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (route handlers): never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Generate a new one for production: openssl rand -hex 32. Use the same value in GitHub's webhook settings.
GH_WEBHOOK_SECRET=
