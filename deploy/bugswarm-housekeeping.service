# /etc/systemd/system/bugswarm-housekeeping.service (started daily by the timer)
[Unit]
Description=BugSwarm housekeeping (old evidence, caches, orphan checkouts, Docker leftovers)
After=network-online.target docker.service

[Service]
Type=oneshot
User=bugswarm
Group=bugswarm
SupplementaryGroups=docker
WorkingDirectory=/opt/bugswarm/worker
EnvironmentFile=/etc/bugswarm/worker.env
Environment=WORK_ROOT=/var/lib/bugswarm/work
ExecStart=/usr/bin/node dist/housekeeping.js
