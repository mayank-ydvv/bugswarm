# Worker environment for a server: /etc/bugswarm/worker.env (owner root, mode 600).
# Every value here is server-only. Never put these in the web app's public env.

# Hosted Supabase. Use the session pooler (port 5432) or the direct connection; the transaction pooler
# (port 6543) also works (prepared statements are turned off automatically).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AI (model names are examples that worked in Oct 2026; list current ones with your key).
GEMINI_KEY=
GEMINI_LITE=gemini-3.5-flash-lite
GEMINI_FLASH=gemini-3.8-flash
OPENROUTER_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free

CONCURRENCY=2
# Linux reaches sandbox containers directly; the 127.0.0.1 relay is only for Docker Desktop.
DOCKER_PUBLISH_PORTS=false
# file:// repos are a local-dev convenience; keep them off on a server.
ALLOW_FILE_REPOS=false
SEMGREP_CONFIG=p/default
# Optional extra isolation for untrusted code (setup-worker.sh --gvisor installs it).
# SANDBOX_RUNTIME=runsc
# EVIDENCE_RETENTION_DAYS=30
# LLM_CACHE_RETENTION_DAYS=90
