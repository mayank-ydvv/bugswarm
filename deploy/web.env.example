# Web app environment (e.g. Vercel → Settings → Environment Variables).
# NEXT_PUBLIC_* values are shipped to browsers; they are public by design (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (route handlers): never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional operator-wide webhook secret; projects use their own (Project settings → Scan on every push).
GH_WEBHOOK_SECRET=
